{
	"$schema": "wtq.schema.json",
	"Apps": [
		{
			"Name": "Wezterm",
			"Hotkeys": [
				{
					"Modifiers": "Control",
					"KeyChar": "i"
				}
			],
			"FileName": "wezterm-gui.exe",
			"AttachMode": "FindOrStart",
			"MainWindow": "MainWindowOnly",
			"AlwaysOnTop": true,
			"HideOnFocusLost": "Never",
			"TaskbarIconVisibility": "AlwaysVisible",
			"Resize": "Always",
			"HorizontalScreenCoverage": 100,
			"HorizontalAlign": "Center",
			"VerticalScreenCoverage": 100,
			"AnimationDurationMs": 0,
			"AnimationTypeToggleOn": "Linear",
			"AnimationTypeToggleOff": "Linear"
		}
	],
	"ShowUiOnStart": true,
	"AlwaysOnTop": true,
	"PreferMonitor": "Primary"
}