{{ if eq .chezmoi.os "windows" -}}
# run_onchange_ なので、展開結果が変わったとき (= 拡張を増減したとき) だけ走る。
# 入れるだけでアンインストールはしないので、このマシンだけで入れた拡張は残る。
$ErrorActionPreference = 'Stop'

$ids = @(
{{- range .vscode.extensions }}
    '{{ . }}'
{{- end }}
)

if ($ids.Count -gt 0) {
    if (-not (Get-Command code -ErrorAction SilentlyContinue)) {
        Write-Warning 'code コマンドが見つかりません。VSCode を先に入れてください'
    } else {
        # -contains は大文字小文字を区別しないので拡張 ID の比較にそのまま使える
        $installed = & code --list-extensions
        foreach ($id in $ids) {
            if ($installed -contains $id) {
                Write-Host "skip: $id"
                continue
            }
            Write-Host "installing: $id"
            & code --install-extension $id --force
        }
    }
}
{{ end -}}
